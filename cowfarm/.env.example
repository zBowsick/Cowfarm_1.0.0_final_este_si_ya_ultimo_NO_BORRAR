

# --- Base de datos (MariaDB / MySQL) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cowfarm

# --- Seguridad / JWT ---
# OBLIGATORIO: cadena larga y aleatoria (nunca la dejes vacía).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# --- CORS: dominios del frontend autorizados (separados por coma) ---
# OBLIGATORIO: si falta, el backend no arranca (fallo seguro).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200,http://127.0.0.1:4200,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://localhost:5501,http://127.0.0.1:5502,http://localhost:5502

# --- Login con Google (https://console.cloud.google.com/apis/credentials) ---
# Debe ser EL MISMO Client ID que se usa en el frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Login con Facebook (https://developers.facebook.com/apps) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
VITE_FACEBOOK_APP_ID=

# --- Correo del formulario de Contacto (SMTP) ---
# Si usas Gmail, SMTP_PASSWORD debe ser una "contraseña de aplicación"
# (no la contraseña normal): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cowfarmcolombia@gmail.com
SMTP_PASSWORD=
# A qué correo llegan los mensajes del formulario de contacto.
CONTACT_EMAIL_TO=cowfarmcolombia@gmail.com

# =============================================================================
# FRONTEND (Vite)
# =============================================================================

# URL base del backend FastAPI (ajusta si corre en otro host/puerto)
VITE_API_BASE_URL=http://127.0.0.1:8000
